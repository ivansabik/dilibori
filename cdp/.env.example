# Copy to .env and adjust if needed. Defaults match workspaceConfig.json.

JOBS_DB_USER=rudder
JOBS_DB_PASSWORD=password
JOBS_DB_DB_NAME=jobsdb
JOBS_DB_HOST_PORT=6432

RUDDER_HOST_PORT=8080
EVENT_SINK_HOST_PORT=8090

# Must match writeKey values in workspaceConfig.json
RUDDERSTACK_JS_WRITE_KEY=dilibori_js_write_key_local
RUDDERSTACK_HTTP_WRITE_KEY=dilibori_http_write_key_local

# Optional; ignored when CONFIG_FROM_FILE=true
WORKSPACE_TOKEN=local-unused
