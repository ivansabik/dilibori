RUNTIME_AGENT_TOKEN=change-me
DATA_DIR=/var/lib/dilibori
TENANT_IMAGE=dilibori/tastyigniter:poc
ALLOWED_IMAGES=dilibori/tastyigniter:poc
SHARED_NETWORK=dilibori-dev-shared
CADDY_CONTAINER_NAME=dilibori-dev-caddy

MARIADB_HOST=mariadb
MARIADB_ADMIN_USER=root
MARIADB_ADMIN_PASSWORD=secret
MARIADB_PORT=3306

PROXYSQL_HOST=proxysql
PROXYSQL_MYSQL_PORT=6033
PROXYSQL_ADMIN_HOST=proxysql
PROXYSQL_ADMIN_PORT=6032
PROXYSQL_ADMIN_USER=radmin
PROXYSQL_ADMIN_PASSWORD=platform-proxysql-admin

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false
OBJECT_STORE_IDENTITY=minio
MEDIA_BUCKET=dilibori-media
OBJECT_STORE_IAM_PATH=dilibori/local/tenants/

INGRESS_SCHEME=http
CDP_ENABLED=true
TENANT_MAIL_HOST=mailpit
TENANT_MAIL_PORT=1025

RUNTIME_AGENT_HOST=0.0.0.0
RUNTIME_AGENT_PORT=8080
