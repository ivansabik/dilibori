RUNTIME_AGENT_TOKEN=change-me
DATA_DIR=/var/lib/dilibori
TENANT_IMAGE=dilibori/tastyigniter:poc
ALLOWED_IMAGES=dilibori/tastyigniter:poc
SHARED_NETWORK=dilibori-shared
CADDY_CONTAINER_NAME=dilibori-caddy

MARIADB_HOST=mariadb
MARIADB_ADMIN_USER=root
MARIADB_ADMIN_PASSWORD=secret
MARIADB_PORT=3306

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ADMIN_PASSWORD=secret

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false

RUNTIME_AGENT_HOST=0.0.0.0
RUNTIME_AGENT_PORT=8080
