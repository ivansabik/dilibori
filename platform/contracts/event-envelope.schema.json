{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dilibori.local/schemas/event-envelope.schema.json",
  "title": "Tenant-aware event envelope",
  "type": "object",
  "required": [
    "tenant_id",
    "deployment_id",
    "cell_id",
    "environment",
    "event",
    "timestamp",
    "properties"
  ],
  "additionalProperties": false,
  "properties": {
    "tenant_id": { "type": "string", "format": "uuid" },
    "deployment_id": { "type": "string", "format": "uuid" },
    "cell_id": { "type": "string" },
    "environment": {
      "type": "string",
      "enum": ["development", "staging", "production"]
    },
    "event": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "user_id": { "type": ["string", "null"] },
    "anonymous_id": { "type": ["string", "null"] },
    "properties": {
      "type": "object",
      "properties": {
        "local_entity_type": { "type": "string" },
        "local_entity_id": { "type": "string" },
        "namespaced_entity_id": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
