MARIADB_ROOT_PASSWORD=platform-root-change-me
PROXYSQL_ADMIN_PASSWORD=platform-proxysql-admin
REDIS_ADMIN_PASSWORD=platform-redis-admin
MINIO_ROOT_USER=platformminio
MINIO_ROOT_PASSWORD=platform-minio-change-me
POSTGRES_PASSWORD=platform-pg-change-me
RUNTIME_AGENT_TOKEN=platform-agent-token-change-me
APP_SECRET_KEY=0123456789abcdef0123456789abcdef
TENANT_IMAGE=dilibori/tastyigniter:poc
ALLOWED_IMAGES=dilibori/tastyigniter:poc
# Absolute host paths required so the runtime agent can bind-mount into tenant containers.
# Makefile `make up` sets these automatically when empty.
HOST_SEEDS_PATH=
HOST_EXTENSIONS_PATH=
HOST_DATA_PATH=
HOST_APP_SEED_PATH=
HOST_CELL_B_DATA_PATH=
# Ports and PLATFORM_ENV live in envs/dev.env and envs/prod.env (make ENV=dev|prod).
