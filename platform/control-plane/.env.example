APP_NAME=dilibori-control-plane
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-at-least-32-random-bytes

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/control_plane
# Or discrete vars:
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=control_plane
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

RUNTIME_AGENT_URL=http://127.0.0.1:8081
RUNTIME_AGENT_TOKEN=

PROFILES_PATH=/opt/platform/profiles
SECRETS_PATH=/var/lib/dilibori/secrets
DEFAULT_ACTOR=control-plane
