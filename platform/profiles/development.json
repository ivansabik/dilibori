{
  "version": "1.0.0",
  "name": "development",
  "description": "Local development profile with detailed logs and relaxed local settings.",
  "config": {
    "APP_ENV": "local",
    "APP_DEBUG": true,
    "LOG_LEVEL": "debug",
    "LOG_STACK_TRACES": true,
    "SESSION_SECURE_COOKIE": false,
    "SESSION_SAME_SITE": "lax",
    "TRUSTED_PROXIES": "*",
    "CACHE_DRIVER": "file",
    "QUEUE_CONNECTION": "database",
    "MAIL_MAILER": "smtp",
    "ALLOW_SOURCE_MOUNTS": true,
    "READ_ONLY_ROOTFS": false,
    "APACHE_MAX_REQUEST_WORKERS": 4,
    "QUEUE_WORKER_SLEEP": 3,
    "DB_PERSISTENT": false,
    "MEMORY_LIMIT_MB": 384,
    "CPU_LIMIT": 0.5,
    "MAX_USER_CONNECTIONS": 10,
    "CDP_ENABLED": true,
    "EVENT_CLIENT_DRIVER": "rudderstack",
    "RUDDERSTACK_DATA_PLANE_URL": "http://host.docker.internal:8080",
    "RUDDERSTACK_JS_DATA_PLANE_URL": "http://127.0.0.1:8080",
    "RUDDERSTACK_JS_CONFIG_URL": "http://127.0.0.1:8090",
    "RUDDERSTACK_HTTP_WRITE_KEY": "dilibori_http_write_key_local",
    "RUDDERSTACK_JS_WRITE_KEY": "dilibori_js_write_key_local"
  },
  "invariants": {
    "APP_DEBUG_may_be_true": true,
    "require_secure_cookies": false,
    "forbid_marketplace_install": true,
    "forbid_self_update": true
  },
  "allowlisted_tenant_overrides": [
    "MAIL_FROM_ADDRESS",
    "MAIL_FROM_NAME",
    "ADMIN_EMAIL",
    "APP_URL",
    "LOG_LEVEL"
  ]
}
