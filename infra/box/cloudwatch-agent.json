{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "CWAgent",
    "metrics_collected": {
      "mem": {
        "measurement": ["mem_used_percent"]
      },
      "disk": {
        "measurement": ["used_percent"],
        "metrics_collection_interval": 60,
        "resources": ["/", "/opt/dilibori"]
      }
    },
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/opt/dilibori/logs/*.log",
            "log_group_name": "/dilibori/${environment}/platform",
            "log_stream_name": "{instance_id}/box",
            "retention_in_days": 30
          },
          {
            "file_path": "/opt/dilibori/caddy-data/logs/access.log",
            "log_group_name": "/dilibori/${environment}/caddy",
            "log_stream_name": "{instance_id}/caddy",
            "retention_in_days": 30
          }
        ]
      }
    }
  }
}
