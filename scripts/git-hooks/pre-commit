#!/usr/bin/env bash
# Git pre-commit: same Ruff check as Python CI.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

changed="$(git diff --cached --name-only --diff-filter=ACMR || true)"
if [ -z "$changed" ]; then
  exit 0
fi

need_ruff=0
while IFS= read -r path; do
  case "$path" in
    cdp/event-sink/*|ruff.toml|*.py)
      need_ruff=1
      break
      ;;
  esac
done <<< "$changed"

if [ "$need_ruff" -eq 0 ]; then
  exit 0
fi

echo "pre-commit: ruff (cdp/event-sink)..."
ruff check cdp/event-sink
ruff format --check cdp/event-sink
echo "pre-commit: OK"
