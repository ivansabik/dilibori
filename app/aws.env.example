# Dummy values so `docker compose -f app/docker-compose.aws.yml config` works
# without AWS. The box writes the real file to /opt/dilibori/app.env.
DOMAIN=example.com
APP_IMAGE=dilibori/tastyigniter:local
MARIADB_ROOT_PASSWORD=change-me
DB_PASSWORD=change-me
AWS_REGION=us-east-1
PLATFORM_BOX_ENV=dev
HOST_MEDIA_PATH=/tmp/dilibori/media
HOST_DB_PATH=/tmp/dilibori/db
HOST_CADDY_PATH=/tmp/dilibori/caddy
